{
  "name": "brever.link",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:remote": "astro dev --remote",
    "build": "astro build --remote",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "prettier . --write",
    "lint:check": "prettier . --check",
    "lint:eslint": "eslint . --ext .ts,.tsx,.astro",
    "lint:eslint:fix": "eslint . --ext .ts,.tsx,.astro --fix",
    "lint:fix": "prettier . --write && eslint . --ext .ts,.tsx,.astro --fix",
    "check": "astro check",
    "push:db": "astro db push --remote",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/db": "0.20.1",
    "@astrojs/netlify": "6.5.9",
    "@astrojs/react": "4.3.0",
    "@formkit/tempo": "0.1.2",
    "@hookform/resolvers": "5.2.2",
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@uidotdev/usehooks": "2.4.1",
    "astro": "5.18.1",
    "drizzle-orm": "0.45.2",
    "qrcode": "1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.72.1",
    "sonner": "2.0.7",
    "tailwindcss": "4.2.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.0",
    "@commitlint/config-conventional": "19.6.0",
    "@eslint/js": "9.17.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/qrcode": "1.5.6",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "8.58.2",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "eslint": "9.39.4",
    "eslint-plugin-astro": "1.7.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "prettier": "3.8.2",
    "prettier-plugin-astro": "0.14.1",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.2"
    }
